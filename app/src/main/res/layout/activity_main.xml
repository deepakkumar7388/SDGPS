<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_screen_bg"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Premium Header Illustration -->
            <ImageView
                android:id="@+id/headerIllustration"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_margin="-24dp"
                android:scaleType="centerCrop"
                android:src="@drawable/login_header_bg"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Login CardView (Overlaps the illustration slightly) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="260dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Logo and Title Horizontal Layout -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/logofornotification2" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DIGITAL"
                                android:textColor="#4B72FA"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PASS"
                                android:textColor="#7E57FF"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Seamless Access. Anytime. Anywhere."
                        android:textColor="#8F9CAE"
                        android:textSize="13sp"
                        android:layout_marginBottom="28dp" />

                    <!-- Input Fields with custom styling -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Enter Username"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#E0E6F2"
                        app:hintTextColor="#7E57FF"
                        app:startIconDrawable="@android:drawable/ic_dialog_email"
                        app:startIconTint="#8F9CAE">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:autofillHints="emailAddress"
                            android:importantForAutofill="yes"
                            android:textColor="#333333"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#E0E6F2"
                        app:hintTextColor="#7E57FF"
                        app:passwordToggleEnabled="true"
                        app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                        app:startIconTint="#8F9CAE">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:autofillHints="password"
                            android:importantForAutofill="yes"
                            android:textColor="#333333"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/forgetPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:padding="8dp"
                        android:text="Forgot Password?"
                        android:textColor="#4B72FA"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <!-- Login Button with custom gradient background -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/login_btn_bg"
                        app:backgroundTint="@null"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <!-- Social Login Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="20dp"/>

                    <!-- Google & Apple Social Login buttons -->

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom descriptive instruction footer -->
            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="If you have no account, please contact your administrator for registration."
                android:textColor="#757575"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/loginCard" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.example.digitalpass.CustomProgressBar
        android:id="@+id/customProgressBar"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cinematic Secure Gateway Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gatewayOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A0E1A"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Background Ambient particles -->
        <View
            android:id="@+id/particle1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/glowing_particle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="120dp" />

        <View
            android:id="@+id/particle2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/glowing_particle"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginRight="80dp"
            android:layout_marginTop="220dp" />

        <View
            android:id="@+id/particle3"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/glowing_particle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginLeft="90dp"
            android:layout_marginBottom="200dp" />

        <View
            android:id="@+id/particle4"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/glowing_particle"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginRight="70dp"
            android:layout_marginBottom="140dp" />

        <View
            android:id="@+id/particle5"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/glowing_particle"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="320dp" />

        <!-- Left Gate Panel -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/leftGate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/gate_bg_gradient"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.5">

            <!-- Right-side border (Seam Edge) -->
            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#00F2FE"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Left part of Emblem circular container -->
            <View
                android:id="@+id/leftEmblemPlate"
                android:layout_width="72dp"
                android:layout_height="144dp"
                android:background="@drawable/emblem_left_plate"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Left part of Emblem (D) -->
            <TextView
                android:id="@+id/leftEmblemText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D"
                android:textColor="#00F2FE"
                android:textSize="54sp"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"
                android:shadowColor="#8000F2FE"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Right Gate Panel -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rightGate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/gate_bg_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5">

            <!-- Left-side border (Seam Edge) -->
            <View
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:background="#00F2FE"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Right part of Emblem circular container -->
            <View
                android:id="@+id/rightEmblemPlate"
                android:layout_width="72dp"
                android:layout_height="144dp"
                android:background="@drawable/emblem_right_plate"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Right part of Emblem (P) -->
            <TextView
                android:id="@+id/rightEmblemText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="P"
                android:textColor="#00F2FE"
                android:textSize="54sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:shadowColor="#8000F2FE"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="15"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Neon Scanning Beam -->
        <View
            android:id="@+id/scannerBeam"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/scanner_beam_glow"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Access Granted Text -->
        <TextView
            android:id="@+id/accessGrantedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESS GRANTED"
            android:textColor="#2AF598"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:shadowColor="#802AF598"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20"
            app:layout_constraintBottom_toTopOf="@id/gatewayStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="32dp" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/gatewayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:text="Authenticating Credentials"
            android:textColor="#8F9CAE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#408F9CAE"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>