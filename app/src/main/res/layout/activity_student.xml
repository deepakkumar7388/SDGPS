<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Student">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00000000">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@drawable/appbar_gradient_bg"
                android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:contentInsetStart="16dp"
                app:contentInsetEnd="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Digital Pass"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/bellContainer"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_toStartOf="@id/profileCard"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless">

                        <ImageView
                            android:id="@+id/notificationBell"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell"
                            app:tint="#FFFFFF" />

                        <View
                            android:id="@+id/notificationBadge"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_red_dot"
                            android:visibility="gone" />
                    </FrameLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/profileCard"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#4DFFFFFF"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/ProfileImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:scaleType="centerCrop"
                            android:src="@drawable/user_icon" />
                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>

            </com.google.android.material.appbar.MaterialToolbar>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <include
                    android:id="@+id/updateBanner"
                    layout="@layout/updateappview"
                    android:visibility="gone" />

                    <!-- Actions Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="24dp"
                        android:text="Student Actions"
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <LinearLayout
                        android:id="@+id/linearLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/applyForGatePass"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:backgroundTint="#FFFFFF"
                            android:padding="12dp"
                            android:text="Apply Gate Pass"
                            android:textAllCaps="false"
                            android:textColor="#3B82F6"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:elevation="3dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="#E2E8F0"
                            app:rippleColor="#F1F5F9"
                            app:icon="@android:drawable/ic_input_add"
                            app:iconSize="24dp"
                            app:iconTint="#3B82F6" />

                    </LinearLayout>

                    <!-- Activity Section Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginTop="8dp"
                        android:text="Applied Passes"
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/studentRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/historyitem" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <com.example.digitalpass.CustomProgressBar
                android:id="@+id/customProgressBar"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/successOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/paytm_gradient_bg"
                android:visibility="gone"
                android:elevation="20dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/successBlob"
                    android:layout_width="300dp"
                    android:layout_height="300dp"
                    android:background="@drawable/success_glow_radial"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/glowRing"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:background="@drawable/success_glow_ring"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginBottom="80dp" />

                <View
                    android:id="@+id/successCircle"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/success_circle_bg"
                    app:layout_constraintBottom_toBottomOf="@id/glowRing"
                    app:layout_constraintEnd_toEndOf="@id/glowRing"
                    app:layout_constraintStart_toStartOf="@id/glowRing"
                    app:layout_constraintTop_toTopOf="@id/glowRing" />

                <ImageView
                    android:id="@+id/successCheckmark"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_success_check"
                    app:layout_constraintBottom_toBottomOf="@id/successCircle"
                    app:layout_constraintEnd_toEndOf="@id/successCircle"
                    app:layout_constraintStart_toStartOf="@id/successCircle"
                    app:layout_constraintTop_toTopOf="@id/successCircle" />

                <View android:id="@+id/confetti1" android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/confetti_p1" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="@id/successCircle" app:layout_constraintEnd_toEndOf="@id/successCircle" app:layout_constraintStart_toStartOf="@id/successCircle" app:layout_constraintTop_toTopOf="@id/successCircle" />
                <View android:id="@+id/confetti2" android:layout_width="16dp" android:layout_height="8dp" android:background="@drawable/confetti_p2" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="@id/successCircle" app:layout_constraintEnd_toEndOf="@id/successCircle" app:layout_constraintStart_toStartOf="@id/successCircle" app:layout_constraintTop_toTopOf="@id/successCircle" />
                <View android:id="@+id/confetti3" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/confetti_p3" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="@id/successCircle" app:layout_constraintEnd_toEndOf="@id/successCircle" app:layout_constraintStart_toStartOf="@id/successCircle" app:layout_constraintTop_toTopOf="@id/successCircle" />
                <View android:id="@+id/confetti4" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/confetti_p4" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="@id/successCircle" app:layout_constraintEnd_toEndOf="@id/successCircle" app:layout_constraintStart_toStartOf="@id/successCircle" app:layout_constraintTop_toTopOf="@id/successCircle" />
                <View android:id="@+id/confetti5" android:layout_width="8dp" android:layout_height="16dp" android:background="@drawable/confetti_p5" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="@id/successCircle" app:layout_constraintEnd_toEndOf="@id/successCircle" app:layout_constraintStart_toStartOf="@id/successCircle" app:layout_constraintTop_toTopOf="@id/successCircle" />
                <View android:id="@+id/confetti6" android:layout_width="12dp" android:layout_height="12dp" android:background="@drawable/confetti_p6" android:visibility="invisible" app:layout_constraintBottom_toBottomOf="@id/successCircle" app:layout_constraintEnd_toEndOf="@id/successCircle" app:layout_constraintStart_toStartOf="@id/successCircle" app:layout_constraintTop_toTopOf="@id/successCircle" />

                <TextView
                    android:id="@+id/successTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Gate Pass Applied!"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/glowRing" />

                <TextView
                    android:id="@+id/successSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Pending approval from administration"
                    android:textColor="#8F9CAE"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingHorizontal="32dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/successTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <include layout="@layout/layout_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>
