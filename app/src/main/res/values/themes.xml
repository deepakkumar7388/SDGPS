<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.DigitalPass" parent="Theme.Material3.Light.NoActionBar">
        <!-- Suppress Android 15 edge-to-edge enforcement warning.
             setStatusBarColor / setNavigationBarColor are called internally by
             the Material BottomSheetDialog library (not our code). Remove this item
             once a Material library version ships with native Android 15 support. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.DigitalPass" parent="Base.Theme.DigitalPass" />
    <style name="CircleImageView">
        <item name="cornerSize">50%</item>
    </style>
    <!-- Sidebar Info Row Container -->
    <style name="SidebarInfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Icon Style -->
    <style name="SidebarIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="tint">#052E92</item> <!-- Correct: No app: prefix inside the name -->
    </style>

    <!-- Text Stack Container -->
    <style name="SidebarTextStack">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- Label (Small Grey Text) -->
    <style name="SidebarLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#757575</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Value (Large Dark Text) -->
    <style name="SidebarValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#212121</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Sidebar Section Divider -->
    <style name="SidebarDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#EEEEEE</item>
        <item name="android:layout_marginVertical">12dp</item>
    </style>

    <!-- Full Screen Image Dialog Style -->
    <style name="FullScreenImageDialog" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    </resources>
